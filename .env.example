# 复制为 .env 后填写真实值；.env 不入库。
ILLUMINATION_ENV=dev
ILLUMINATION_TIMEZONE=Asia/Shanghai

# 仅支持 PostgreSQL；开发库与测试库必须是不同的数据库。
ILLUMINATION_DATABASE_URL=postgresql+psycopg://postgres:change-me@127.0.0.1:15432/illumination
ILLUMINATION_TEST_DATABASE_URL=postgresql+psycopg://postgres:change-me@127.0.0.1:15432/illumination_test

# 逗号分隔的邀请码；替换为本地值，生产环境必填。
ILLUMINATION_INVITE_CODES=bb_dev=开发用户

# 模型配置
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=
ILLUMINATION_MODEL_MAIN=deepseek-chat
